{
  "expo": {
    "name": "Aniel Next",
    "slug": "aniel-next",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.anielnext.touch",
      "adaptiveIcon": {
        "backgroundColor": "#08776F",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false,
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "O Aniel Next precisa da câmera para ler códigos de barras/seriais e capturar fotos da obra."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O Aniel Next precisa da sua localização para registrar o atendimento e a baixa da atividade na obra."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Aniel Next precisa de acesso às suas fotos para anexar evidências à obra.",
          "cameraPermission": "O Aniel Next precisa da câmera para registrar fotos da obra."
        }
      ],
      "expo-video",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#08776F",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B1117"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3ffe1392-be89-48a4-9682-cfc11e3cee79"
      }
    },
    "owner": "rinnegan",
    "updates": {
      "url": "https://u.expo.dev/3ffe1392-be89-48a4-9682-cfc11e3cee79"
    }
  }
}
